{
    "name": "jooservices/flickr",
    "description": "Flickr REST/OAuth/upload SDK on jooservices client v4 and dto v3",
    "license": "MIT",
    "type": "library",
    "keywords": ["flickr", "sdk", "oauth1", "psr-18"],
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "jooservices/client": "~4.0.0",
        "jooservices/dto": "~3.0.0",
        "nyholm/psr7": "^1.8",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "laravel/pint": "^1.18",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^3.12 || ^4.0",
        "symfony/cache": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "JOOservices\\Flickr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JOOservices\\Flickr\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:coverage": "phpunit --coverage-clover coverage.xml --coverage-html coverage",
        "coverage:check": "php tools/coverage-enforce.php coverage.xml 85.00",
        "verify:registry": "php tools/verify-method-registry.php",
        "verify:api-surface": "php tools/verify-api-index.php",
        "generate:api-index": "php tools/generate-api-surface.php",
        "verify:smoke": "php tools/consumer-smoke.php",
        "lint:pint": "pint --test",
        "lint:pint:fix": "pint",
        "lint:phpcs": "phpcs --standard=phpcs.xml",
        "lint:phpstan": "XDEBUG_MODE=off phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
        "lint:phpmd": "php -d error_reporting=6143 vendor/bin/phpmd src text phpmd.xml",
        "lint:cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "lint:cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "lint": ["@lint:pint", "@lint:phpcs", "@lint:phpstan", "@lint:phpmd", "@lint:cs"],
        "lint:fix": ["@lint:pint:fix", "@lint:cs:fix"],
        "check": ["@validate-inner", "@verify:registry", "@verify:api-surface", "@lint", "@test"],
        "ci": ["@check", "@verify:smoke", "@test:coverage", "@coverage:check"],
        "validate-inner": "composer validate --strict"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
